# Postgres-Connection-String (Neon / Vercel Postgres / Supabase / Docker)
# Beispiel Neon: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# Root-Domain auf der die App laeuft
NEXT_PUBLIC_ROOT_DOMAIN="kaiman.studio"

# Lokale Entwicklung: localhost wird als Root behandelt
NEXT_PUBLIC_DEV_DOMAIN="lvh.me:3000"
